{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SuperCalc Truth Audit Response",
  "type": "object",
  "required": ["summary", "audited_run", "truth_items", "false_positive_admissions", "corrections"],
  "properties": {
    "summary": { "type": "string", "minLength": 1 },
    "audited_run": { "type": "string", "enum": ["run1", "run2", "Run 1", "Run 2"] },
    "truth_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "self_assessment", "previous_output_quote", "rationale", "admits_miss", "overclaims"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "self_assessment": { "type": "string", "enum": ["found_full", "found_partial", "missed", "unclear_or_overclaimed"] },
          "previous_output_quote": { "type": "string", "description": "For found_full/found_partial, an exact quote from the audited previous answer; otherwise empty is allowed." },
          "rationale": { "type": "string", "minLength": 1 },
          "admits_miss": { "type": "boolean", "description": "True exactly when self_assessment is missed." },
          "overclaims": { "type": "boolean", "description": "Detection-status flag: true for unclear_or_overclaimed or when self_assessment claims more detection credit than the audited result; severity/CWE/etc. corrections do not set this flag." }
        }
      }
    },
    "false_positive_admissions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["previous_finding_quote", "admitted", "rationale"],
        "properties": {
          "previous_finding_quote": { "type": "string" },
          "admitted": { "type": "boolean" },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["previous_claim", "corrected_claim", "correction_type"],
        "properties": {
          "previous_claim": { "type": "string", "minLength": 8, "description": "An exact quote from the audited previous answer." },
          "corrected_claim": { "type": "string", "minLength": 1 },
          "correction_type": { "type": "string", "enum": ["severity", "cwe", "location", "evidence", "impact", "unsupported"] }
        }
      }
    }
  }
}
